# selene-server.service  v1.0  (2026-09-23)
# Selene v3.0 Flask webhook server on 127.0.0.1:5001. Runs only on the LIVE
# machine (ConditionPathExists). Installed + enabled by deploy.sh on Linux.
[Unit]
Description=Selene v3.0 webhook server (5001)
ConditionPathExists=%h/runner/selene/LIVE
After=network-online.target

[Service]
WorkingDirectory=%h/runner/selene/selene-dreams-script-v3.0
Environment=PATH=%h/.local/bin:%h/runner/selene/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/runner/selene/.venv/bin/python server.py
Restart=always
RestartSec=5
StandardOutput=append:%h/runner/logs/selene-server.log
StandardError=inherit

[Install]
WantedBy=default.target
