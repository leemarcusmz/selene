# selene-research.timer  v1.0  (2026-09-23)
# Port of com.selene.research.plist (StartCalendarInterval Mon 10:00). The
# droplet's TZ is Asia/Hong_Kong (w0e), so this is 10:00 HKT. Persistent=true
# fires a missed Monday on next boot, as launchd would.
[Unit]
Description=Selene poke timer: research, Monday 10:00

[Timer]
OnCalendar=Mon 10:00
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
