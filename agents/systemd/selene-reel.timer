# selene-reel.timer  v1.0  (2026-09-23)
# Port of com.selene.reel.plist (StartInterval 900). Boot offsets are
# staggered per lane so the three 15-minute pokes do not land together.
[Unit]
Description=Selene poke timer: reel every 15 min

[Timer]
OnBootSec=4min
OnUnitActiveSec=15min
AccuracySec=30s

[Install]
WantedBy=timers.target
