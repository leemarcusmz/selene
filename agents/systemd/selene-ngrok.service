# selene-ngrok.service  v1.0  (2026-09-23)
# ngrok tunnel to 5001 on the reserved domain (bin/ngrok-up.sh reads it from
# .env.local). LIVE-gated: the free plan allows one live agent per account and
# the domain belongs to whichever machine is LIVE.
[Unit]
Description=Selene ngrok tunnel (reserved domain -> 5001)
ConditionPathExists=%h/runner/selene/LIVE
After=network-online.target selene-server.service
Wants=selene-server.service

[Service]
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/runner/selene/bin/ngrok-up.sh
Restart=always
RestartSec=10
StandardOutput=append:%h/runner/logs/selene-ngrok.log
StandardError=inherit

[Install]
WantedBy=default.target
