# selene-edu-server.service  v1.1  (2026-09-23)
# v1.1: renamed from selene-edu.service, which collided with the edu poke unit.
# Selene educational lane server on 127.0.0.1:5002 (poll-based, no tunnel).
# Runs only on the LIVE machine. Shares v3.0's venv and .env.
[Unit]
Description=Selene educational server (5002)
ConditionPathExists=%h/runner/selene/LIVE
After=network-online.target

[Service]
WorkingDirectory=%h/runner/selene/selene-dreams-educational-v1.0
Environment=PATH=%h/.local/bin:%h/runner/selene/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/runner/selene/.venv/bin/python edu_server.py
Restart=always
RestartSec=5
StandardOutput=append:%h/runner/logs/selene-edu-server.log
StandardError=inherit

[Install]
WantedBy=default.target
