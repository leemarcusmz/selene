# Copy to .env and fill in. config.py refuses to start without these.
APIFY_TOKEN=apify_api_...          # read-only, scoped to the 3 saved scrape tasks
APIFY_RUN_TOKEN=apify_api_...      # "Selene actor runs" — actor Read+Run only
REPLICATE_API_TOKEN=r8_...         # image generation
WEBHOOK_SECRET=...                 # shared with the Apps Script webhooks

# --- Machine-specific paths: put these in .env.local, NOT here ------------
# .env.local overlays .env (config.py, 2026-09-22) and is never committed or
# encrypted, so each machine keeps its own. On the runner, content lives
# outside ~/Desktop so launchd can read it. reel_runner.py --doctor asserts the
# two lanes agree on the caption log. Leave both unset on the MacBook.
#   SELENE_CONTENT_DIR=/Users/marcuslee/SeleneContent
#   SELENE_CAPTION_LOG=/Users/marcuslee/SeleneContent/00. Social Media Posts/caption-log.md
