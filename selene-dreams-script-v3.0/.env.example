# Copy to .env and fill in. config.py refuses to start without these.
APIFY_TOKEN=apify_api_...          # read-only, scoped to the 3 saved scrape tasks
APIFY_RUN_TOKEN=apify_api_...      # "Selene actor runs" — actor Read+Run only
REPLICATE_API_TOKEN=r8_...         # image generation
WEBHOOK_SECRET=...                 # shared with the Apps Script webhooks

# --- Phase 4 (runner): content lives outside ~/Desktop so launchd can read it ---
# Both are read by reel_config.py and caption_runner.py. reel_runner.py --doctor
# asserts they agree. Leave unset on the MacBook; set on the runner.
SELENE_CONTENT_DIR=/Users/marcuslee/SeleneContent
SELENE_CAPTION_LOG=/Users/marcuslee/SeleneContent/caption-log.md
